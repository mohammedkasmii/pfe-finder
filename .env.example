# PFE Finder — environment template.
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
#
# Rules enforced by `src/lib/env.ts`:
#   - Only `NEXT_PUBLIC_`-prefixed variables may reach browser bundles.
#   - No credential-shaped name may carry the `NEXT_PUBLIC_` prefix.
#   - All URLs must be HTTPS (localhost HTTP is tolerated in development only).
#   - Missing public Supabase values are fatal in production builds and runtime.

# ---------------------------------------------------------------------------
# Public — safe to expose to the browser (Vercel: all environments)
# ---------------------------------------------------------------------------

# Supabase project REST URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous key. Read-only by row-level security; never the service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public origin of the deployment, used for metadata and absolute URLs.
# Example: https://pfe-finder.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server only — never prefixed with NEXT_PUBLIC_, never read from client code
# ---------------------------------------------------------------------------

# Optional. Overrides the deployment environment label used in operational logs.
# One of: development | preview | production
APP_ENV=development

# ---------------------------------------------------------------------------
# NOT stored here and NOT used by the web application
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY — bypasses Row Level Security. Used exclusively
# by the ingestion collector (src/lib/collector/cli.ts), invoked only from
# the "Collect offers" GitHub Actions workflow, which reads it from a
# GitHub Actions secret. It must never be given a real value in this file,
# in `.env.local`, in Vercel, in fixtures, in logs, or in client code — the
# Next.js app never reads it (see `src/lib/db/supabase-client.ts`, which
# loads it directly from `process.env`, independent of `src/lib/env.ts`'s
# browser-facing validation). See docs/SECURITY.md.
